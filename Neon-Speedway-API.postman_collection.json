              "status": "Created",
              "code": 201,
              "body": "{\n  \"racer\": {\n    \"id\": \"racer-1712345678901\",\n    \"driverName\": \"Blaze\",\n    \"carModelId\": \"Vanta\",\n    \"color\": \"#ff5f7d\",\n    \"progress\": 100,\n    \"finishTimeMs\": 12430,\n    \"status\": \"finished\"\n  },\n  \"result\": {\n    \"id\": \"result-1712345678902\",\n    \"racerId\": \"racer-1712345678901\",\n    \"position\": 1,\n    \"finishTimeMs\": 12430\n  },\n  \"personalBest\": {\n    \"carModelId\": \"Vanta\",\n    \"finishTimeMs\": 12430,\n    \"isNewPersonalBest\": true\n  }\n}"
            },
