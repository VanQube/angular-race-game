        {
          "name": "Toggle Favorite Car Model",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{server_url}}/api/car-models/Vanta/favorite",
              "host": [
                "{{server_url}}"
              ],
              "path": [
                "api",
                "car-models",
                "Vanta",
                "favorite"
              ]
            },
            "description": "Toggles a car model in and out of the caller's favorites. The first call on a given id favorites it (`favorited: true`); calling it again on the same id un-favorites it (`favorited: false`) — the same route handles both directions. Returns the caller's full updated favorites list. Fails with 404 if the car model id is not one of the seeded models."
          },
          "response": [
            {
              "name": "200 OK - favorited",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{authToken}}"
                  }
                ],
                "url": {
                  "raw": "{{server_url}}/api/car-models/Vanta/favorite",
                  "host": [
                    "{{server_url}}"
                  ],
                  "path": [
                    "api",
                    "car-models",
                    "Vanta",
                    "favorite"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"carModelId\": \"Vanta\",\n  \"favorited\": true,\n  \"favoriteCarModelIds\": [\"Vanta\"]\n}"
            },
            {
              "name": "200 OK - un-favorited (second call on the same id)",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{authToken}}"
                  }
                ],
                "url": {
                  "raw": "{{server_url}}/api/car-models/Vanta/favorite",
                  "host": [
                    "{{server_url}}"
                  ],
                  "path": [
                    "api",
                    "car-models",
                    "Vanta",
                    "favorite"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"carModelId\": \"Vanta\",\n  \"favorited\": false,\n  \"favoriteCarModelIds\": []\n}"
            },
            {
              "name": "404 Not Found - unknown car model",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{authToken}}"
                  }
                ],
                "url": {
                  "raw": "{{server_url}}/api/car-models/Not-A-Real-Model/favorite",
                  "host": [
                    "{{server_url}}"
                  ],
                  "path": [
                    "api",
                    "car-models",
                    "Not-A-Real-Model",
                    "favorite"
                  ]
                }
              },
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"error\": {\n    \"code\": \"NOT_FOUND\",\n    \"message\": \"car model not found\"\n  }\n}"
            }
          ]
        }
      ]
