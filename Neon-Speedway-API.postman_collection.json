              "host": [
                "{{server_url}}"
              ],
              "path": [
                "api",
                "races",
                "{{raceId}}",
                "rematch"
              ]
            },
            "description": "Creates a new race by cloning the racers from an existing race owned by the caller, resetting each one to the starting line (progress 0, no finish time, status \"ready\"). Results are not copied, since they belong to the run being repeated. The new race is created with status \"pending\" and a `sourceRaceId` pointing back to the original. Fails with 400 if the source race has no racers, and 404 if the race doesn't exist or isn't owned by the caller."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{authToken}}"
