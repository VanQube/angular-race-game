              "body": "{\n  \"name\": \"Sunset Sprint (Rematch)\",\n  \"status\": \"pending\",\n  \"ownerId\": \"64a7f8c90d4bba5f0a999999\",\n  \"sourceRaceId\": \"64a7f8c90d4bba5f0a123456\",\n  \"createdAt\": \"2026-08-05T15:45:00.000Z\",\n  \"racers\": [\n    {\n      \"id\": \"racer-1712345678901\",\n      \"name\": \"Blaze\",\n      \"carModel\": \"Vanta\",\n      \"color\": \"#ff5f7d\",\n      \"progress\": 0,\n      \"finishTimeMs\": null,\n      \"status\": \"ready\"\n    }\n  ],\n  \"results\": [],\n  \"id\": \"64a7f8c90d4bba5f0a654321\"\n}"
