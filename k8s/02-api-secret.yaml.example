# Copy this to 02-api-secret.yaml.local (gitignored) and fill in a real value:
#   cp k8s/02-api-secret.yaml.example k8s/02-api-secret.yaml.local
#   sed -i '' "s/replace-me/$(openssl rand -hex 32)/" k8s/02-api-secret.yaml.local
apiVersion: v1
kind: Secret
metadata:
  name: api-secret
  namespace: race-game
type: Opaque
stringData:
  AUTH_SECRET: replace-me
